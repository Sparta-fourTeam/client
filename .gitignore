# =============================================================
# Unity .gitignore
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Last synced: 2026-07-02 | License: CC0-1.0
# Place this file at the root of the Unity project.
# =============================================================

# ----- Unity 생성 폴더 -----
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures: 용량이 크고 민감한 데이터가 포함될 수 있음
/[Mm]emoryCaptures/

# Recordings: 용량이 큼
/[Rr]ecordings/

# ----- Blender -----
*.blend1
*.blend1.meta

# ----- Asset Store Tools (필요 시 주석 해제) -----
# /[Aa]ssets/AssetStoreTools*

# ----- IDE / 솔루션 파일 -----
# JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio
.vs/

# Gradle
.gradle/

# 자동 생성 솔루션/프로젝트 파일
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 자동 생성 meta 파일
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ----- 크래시 / 로그 -----
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# ----- 빌드 결과물 -----
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# ----- 테스트 -----
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ----- Addressables -----
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ----- Visual Scripting -----
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ----- 기타 자동 생성 캐시 -----
/[Aa]ssets/[Ss]ceneDependencyCache*


# =============================================================
# Custom additions (템플릿 외 직접 추가한 규칙)
# =============================================================

# macOS
.DS_Store

# JetBrains Rider (전체 IDE 설정)
.idea/
*.sln.iml
out/