      m_Items: []
  - m_Id: 37050177806347
    m_Localized: "\u4F7F\u7528 Google \u767B\u5F55\n"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806348
    m_Localized: "\u4EE5\u8BBF\u5BA2\u8EAB\u4EFD\u5F00\u59CB"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806349
    m_Localized: "\u91CD\u8BD5"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806350
    m_Localized: "\u4EC5\u5728\u4E24\u9879\u5747\u540C\u610F\u65F6\u624D\u4F1A\u5F00\u59CB\u5206\u6790\u3002\n\u4E0D\u9009\u62E9\u4E5F\u53EF\u4EE5\u6E38\u620F\uFF0C\u6240\u9009\u5185\u5BB9\u4F1A\u88AB\u4FDD\u5B58\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806351
    m_Localized: "(\u53EF\u9009) \u540C\u610F\u6536\u96C6\u548C\u4F7F\u7528\u6E38\u620F\u4F7F\u7528\u5206\u6790\u6570\u636E"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806352
    m_Localized: "(\u53EF\u9009) \u540C\u610F\u5C06\u5206\u6790\u4FE1\u606F\u4F20\u8F93\u81F3\u5883\u5916"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806353
    m_Localized: "\u67E5\u770B\u8BE6\u60C5"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806354
    m_Localized: "\u9690\u79C1\u653F\u7B56\u662F\u5904\u7406\u4E8B\u9879\u7684\u8BF4\u660E\u3002\n\u4E0D\u4FDD\u8BC1\u6D4B\u8BD5\u8FDB\u5EA6\u7684\u4FDD\u7559\u53CA\u5411\u6B63\u5F0F\u670D\u52A1\u7684\u8FC1\u79FB\uFF0C\n\u8D26\u53F7\u5220\u9664\u540E\u6CA1\u6709\u6062\u590D\u5BBD\u9650\u671F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806355
    m_Localized: "\u670D\u52A1\u6761\u6B3E\u5168\u6587"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806356
    m_Localized: "\u9690\u79C1\u653F\u7B56"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806357
    m_Localized: "\u6211\u540C\u610F"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806358
    m_Localized: "\u4E0A\u4E00\u6B65"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806359
    m_Localized: "\u4E0D\u540C\u610F"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806360
    m_Localized: "\u5904\u7406\u53D7\u6258\u65B9: GameAnalytics\n\u9879\u76EE: \u5206\u6790\u6807\u8BC6\u7B26\u3001\u8BBE\u5907\xB7\u5E94\u7528\xB7\u4F1A\u8BDD\xB7\u56FD\u5BB6\u4FE1\u606F\u3001\n\u6218\u6597\u7ED3\u679C\xB7\u6CE2\u6570\xB7\u65F6\u95F4\xB7\u51FB\u6740\xB7\u6280\u80FD\u4F24\u5BB3\u91CF\xB7\u5361\u724C\u9009\u62E9\n\u76EE\u7684: \u4F7F\u7528\u60C5\u51B5\xB7\u5E73\u8861\u6539\u8FDB\n\u4FDD\u5B58: \u539F\u59CB\xB7\u6CE8\u91CA 1\u4E2A\u6708 / Player Warehouse 1\u5E74 /\n\u7559\u5B58\u7387\u8BA1\u7B97\u7528 Player Lookup 18\u4E2A\u6708"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806361
    m_Localized: "\u63A5\u6536\u65B9: GameAnalytics ApS \u53CA\u5176\u5173\u8054\u516C\u53F8 (\u7F8E\u56FD)\n\u8054\u7CFB\u65B9\u5F0F: privacy@gameanalytics.com\n\u4F20\u8F93: \u6E38\u620F\u8FC7\u7A0B\u4E2D\u901A\u8FC7 SDK \u7F51\u7EDC\u53D1\u9001\n\u9879\u76EE\xB7\u76EE\u7684\xB7\u4FDD\u5B58: \u4E0E\u4E0A\u8FF0\u5206\u6790\u9879\u76EE\u76F8\u540C"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806362
    m_Localized: "\u4EC5\u5728\u4E24\u9879\u5747\u540C\u610F\u65F6\u624D\u4F1A\u5F00\u59CB\u5206\u6790\u3002\n\u4E0D\u9009\u62E9\u4E5F\u53EF\u4EE5\u6E38\u620F\uFF0C\u6240\u9009\u5185\u5BB9\u4F1A\u88AB\u4FDD\u5B58\u3002\n\u53EF\u5728 \u8BBE\u7F6E \u2192 \u9690\u79C1\u9009\u62E9 \u4E2D\u66F4\u6539\u3002\nUnity \u8BCA\u65AD\u4E0E\u6B64\u9009\u62E9\u65E0\u5173\u3002\n\u505C\u6B62\u4E8B\u4EF6\u4E0D\u7B49\u4E8E\u7EC8\u6B62 SDK \u7684\u5168\u90E8\u901A\u4FE1\u3002\n\u8BF7\u5B8C\u5168\u9000\u51FA\u5E76\u91CD\u65B0\u542F\u52A8\u4EE5\u5E94\u7528\u65B0\u7684\u9009\u62E9\u3002"
    m_Metadata:
      m_Items: []
