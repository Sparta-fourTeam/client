    m_Metadata:
      m_Items: []
  - m_Id: 39957488984224
    m_Localized: "\uC5F0\uACB0\uC774 \uB04A\uACBC\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC5F0\uACB0\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984225
    m_Localized: "\uC11C\uBC84 \uB85C\uADF8\uC778 \uD6C4 \uCC44\uD305\uC744 \uC774\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984226
    m_Localized: "\uCC44\uD305\uC5D0 \uC5F0\uACB0\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC5F0\uACB0\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984227
    m_Localized: "\uC804\uC1A1\uC744 \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB300\uD654\uB97C \uD655\uC778\uD55C \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
