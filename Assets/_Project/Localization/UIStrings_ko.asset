    m_Localized: "\uC0C8 \uC7A5\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789806
    m_Localized: "\uBC29\uBCBD \uCCB4\uB825 {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789807
    m_Localized: "\uAD00\uBB38\uC744 \uD074\uB9AC\uC5B4\uD558\uBA74 \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789808
    m_Localized: "\uBC29\uBCBD \uCCB4\uB825\uC744 {0}% \uC774\uC0C1 \uB0A8\uAE30\uACE0 \uD074\uB9AC\uC5B4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789809
    m_Localized: "\uC81C {0} \uAD00\uBB38 \xB7 \uC774\uBBF8 \uC218\uB839\uD55C \uBCF4\uC0C1\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789810
    m_Localized: "\uC81C {0} \uAD00\uBB38 \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789811
    m_Localized: "\uC81C {0} \uAD00\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789812
    m_Localized: "\uB4F1\uC7A5 \uC694\uB9C8\uC640 \uD074\uB9AC\uC5B4 \uC2DC \uD68D\uB4DD\uD560 \uC218 \uC788\uB294 \uBCF4\uC0C1\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789813
    m_Localized: "\uCD5C\uB300 {0}\uAC1C \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789814
    m_Localized: "\uC218\uB839 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789815
    m_Localized: "\uBCF4\uC0C1 \uBC1B\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789816
    m_Localized: "\uBBF8\uB2EC\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789817
    m_Localized: "\uC81C {0} \uAD00\uBB38\uC758 \uBBF8\uC218\uB839 \uBCF4\uC0C1\uC744 \uBAA8\uB450 \uBC1B\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789818
    m_Localized: "\uC774\uBBF8 \uC218\uB839\uD55C \uBCF4\uC0C1\uC774\uC5D0\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789819
    m_Localized: "\uBCF4\uC0C1\uC744 \uBC1B\uC9C0 \uBABB\uD588\uC5B4\uC694. \uC0C1\uC790 \uC601\uC5ED\uC744 \uB20C\uB7EC \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789820
    m_Localized: "\uAD00\uBB38\uC5D0 \uC785\uC7A5\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694. \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789821
    m_Localized: "\uB2E4\uB978 \uAE30\uAE30\uC5D0\uC11C \uB85C\uADF8\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789822
    m_Localized: "\uB2C9\uB124\uC784 \uBCC0\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789823
    m_Localized: "\uD55C\uAE00, \uC601\uBB38, \uC22B\uC790, \uBC11\uC904(_)\uB85C 2~20\uC790\uB97C \uC785\uB825\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789824
    m_Localized: "\uC0C8 \uB2C9\uB124\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789825
    m_Localized: "\uB2C9\uB124\uC784\uC744 \uBCC0\uACBD\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789826
    m_Localized: "\uC774\uBBF8 \uC0AC\uC6A9 \uC911\uC778 \uB2C9\uB124\uC784\uC785\uB2C8\uB2E4. \uB2E4\uB978 \uC774\uB984\uC744 \uC785\uB825\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789827
    m_Localized: "\uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC5F0\uACB0 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uACE0 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789828
    m_Localized: "\uB2C9\uB124\uC784\uC744 \uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789829
    m_Localized: "\uC81C {0}\uAD00\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789830
    m_Localized: "\uC0AC\uC6A9\uD560 \uCD08\uC0C1\uC744 \uC120\uD0DD\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789831
    m_Localized: "\uC800\uC7A5 \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789832
    m_Localized: "\uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC120\uD0DD\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789833
    m_Localized: "\uC644\uB8CC"
    m_Metadata:
