      m_Items: []
  - m_Id: 39957488984113
    m_Localized: "\uBD84\uC11D \uC815\uBCF4 \uAD6D\uC678 \uC774\uC804 (\uC120\uD0DD)"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984114
    m_Localized: "\uAD6D\uC678 \uC774\uC804 \uB3D9\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984115
    m_Localized: "\uBD84\uC11D\uC5D0 \uB3D9\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984116
    m_Localized: "\uC804\uD22C \uAE30\uB85D\uC744 \uBCF5\uC6D0\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB85C\uBE44\uC5D0\uC11C \uC0C8 \uC804\uD22C\uB97C \uC2DC\uC791\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984117
    m_Localized: "\uC774\uC5B4\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984118
    m_Localized: "\uD3EC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984119
    m_Localized: "\uC9C4\uD589 \uC911\uC778 \uC804\uD22C\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uC774\uC5B4\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\uC81C {0} \uAD00\uBB38 \xB7 {1} \uC6E8\uC774\uBE0C \xB7 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984120
    m_Localized: "\uC804\uD22C \uC774\uC5B4\uD558\uAE30 \uAE30\uB85D\uC740 \uC0AD\uC81C\uB429\uB2C8\uB2E4. \uC800\uC7A5\uB41C \uD018\uC2A4\uD2B8\xB7\uB3C4\uAC10 \uC9C4\uD589\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984121
    m_Localized: "\uC9C4\uD589 \uC800\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984122
    m_Localized: "\uC9C4\uD589 \uAE30\uB85D\uC744 \uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC5F0\uACB0\uC744 \uD655\uC778\uD55C \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984123
    m_Localized: "\uC0C8 \uBC84\uC804 \uC548\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984124
    m_Localized: "\uC0C8\uB85C\uC6B4 \uBC84\uC804\uC774 \uCD9C\uC2DC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC2A4\uD1A0\uC5B4\uC5D0\uC11C \uC5C5\uB370\uC774\uD2B8\uD560\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984125
    m_Localized: "\uC5C5\uB370\uC774\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984126
    m_Localized: "\uB098\uC911\uC5D0"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984127
    m_Localized: "\uBBF8\uD655\uC815 \uAC15\uD654\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uD655\uC778\uC744 \uB204\uB974\uBA74 \uAC19\uC740 \uAD6C\uB9E4\uB97C \uBCF5\uAD6C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984128
    m_Localized: "\uAC15\uD654 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984129
    m_Localized: "{0}\nLv.{1} \u2192 Lv.{2} \xB7 {3}\uD68C \uAC15\uD654\n\uC544\uB798 \uC7AC\uD654\uB97C \uC18C\uBAA8\uD574 \uAC15\uD654\uD560\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984130
    m_Localized: "\uC9C0\uAE08\uC740 \uAC15\uD654\uD560 \uC218 \uC5C6\uC5B4\uC694. \uC7AC\uD654\uC640 \uCD5C\uB300 \uB808\uBCA8\uC744 \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984131
    m_Localized: "\uC7AC\uD654 \uB610\uB294 \uB808\uBCA8\uC774 \uBCC0\uACBD\uB410\uC5B4\uC694. \uBCC0\uACBD\uB41C \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB2E4\uC2DC \uD655\uC778\uC744 \uB20C\uB7EC \uC8FC\uC138\uC694.\n{0} \xB7 Lv.{1} \u2192 Lv.{2} \xB7 {3}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984132
    m_Localized: "{0} \uAC15\uD654 \uC911 \xB7 {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984133
    m_Localized: "\uAC15\uD654 \uB3C4\uC911 \uC7AC\uD654 \uB610\uB294 \uB808\uBCA8\uC774 \uBCC0\uACBD\uB410\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984134
    m_Localized: "\uAC15\uD654 \uACB0\uACFC\uAC00 \uC608\uC0C1 \uB808\uBCA8\uACFC \uB2EC\uB77C\uC694. \uCD5C\uC2E0 \uC0C1\uD0DC\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984135
    m_Localized: "<color=#FFCF5B>{0} Lv.{1} \uAC15\uD654 \uC644\uB8CC!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984136
    m_Localized: "\uAC15\uD654 \uC694\uCCAD\uC744 \uC644\uB8CC\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984137
    m_Localized: "{0}\uD68C \uAC15\uD654 \uC644\uB8CC. {1}\n\uB0A8\uC740 \uAC15\uD654\uC640 \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694.\nLv.{2} \u2192 Lv.{3} \xB7 {4}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984138
    m_Localized: "\uC0C1\uD0DC\uAC00 \uBCC0\uACBD\uB410\uC2B5\uB2C8\uB2E4. \uC0C8 \uBE44\uC6A9\uC744 \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984139
    m_Localized: "\uAC15\uD654 \uACB0\uACFC\uC640 \uD604\uC7AC \uC11C\uBC84 \uC0C1\uD0DC\uB97C \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984140
    m_Localized: "\uAD6C\uB9E4 \uACB0\uACFC\uAC00 \uBBF8\uD655\uC815\uC785\uB2C8\uB2E4. \uD655\uC778\uC744 \uB20C\uB7EC \uAC19\uC740 \uC694\uCCAD\uC744 \uBCF5\uAD6C\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984141
    m_Localized: "{0}\uD68C \uAC15\uD654 \uC644\uB8CC. "
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984142
    m_Localized: "{0}\uAC15\uD654 \uC694\uCCAD \uC2E4\uD328: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984143
    m_Localized: "\uC694\uB9C8\uC758 \uCCB4\uB825\uC774 {0}% \uC99D\uAC00\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984144
    m_Localized: "\uC694\uB9C8\uC758 \uACF5\uACA9\uB825\uC774 {0}% \uC99D\uAC00\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984145
    m_Localized: "\uC694\uB9C8\uC758 \uC774\uB3D9 \uC18D\uB3C4\uAC00 {0}% \uC99D\uAC00\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984146
    m_Localized: "\uAC15\uD654\uD558\uB7EC \uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984147
    m_Localized: "{0} \uD655\uB960"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984148
    m_Localized: "\uD604\uC7AC \uB808\uBCA8\uC5D0\uC11C \uC5F4\uB9B0 \uC2A4\uD0AC\uC758 \uB9C8\uBC95\uBD81\uC774 \uAC19\uC740 \uD655\uB960\uB85C \uB098\uC640\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984149
    m_Localized: "\uD604\uC7AC \uB808\uBCA8\uC5D0\uC11C \uC5F4\uB9B0 \uC7A5\uBE44\uC758 \uC778\uCC48\uD2B8 \uC8FC\uBB38\uC11C\uC774 \uAC19\uC740 \uD655\uB960\uB85C \uB098\uC640\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984150
    m_Localized: "\uB3C4\uAC10 \uB4F1\uB85D \uBCF4\uC0C1\uC744 \uBC1B\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984151
    m_Localized: "\uBCF4\uC0C1\uC744 \uBC1B\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984152
    m_Localized: "\uBCF4\uC0C1 \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984153
    m_Localized: "\uACBD\uD5D8\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984154
    m_Localized: "3\uC131 \uBCF4\uB108\uC2A4 \uACBD\uD5D8\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984155
    m_Localized: "\uB79C\uB364 \uB9C8\uBC95\uBD81"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984156
    m_Localized: "\uB79C\uB364 \uC778\uCC48\uD2B8 \uC8FC\uBB38\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984157
    m_Localized: "\uC5F4\uB9B0 \uC2A4\uD0AC \uC911 \uD558\uB098\uC758 \uB9C8\uBC95\uBD81\uC744 \uBC1B\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984158
    m_Localized: "\uC5F4\uB9B0 \uC7A5\uBE44 \uC911 \uD558\uB098\uC758 \uC778\uCC48\uD2B8 \uC8FC\uBB38\uC11C\uB97C \uBC1B\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984159
    m_Localized: "\uC2A4\uD0AC\uACFC \uC7A5\uBE44\uB97C \uAC15\uD654\uD560 \uB54C \uC4F0\uB294 \uC7AC\uD654\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984160
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C \uBB3C\uD488\uC744 \uC0AC\uB294 \uB370 \uC4F0\uB294 \uC7AC\uD654\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984161
    m_Localized: "\uC2A4\uD14C\uC774\uC9C0\uC5D0 \uC785\uC7A5\uD560 \uB54C \uC4F0\uB294 \uC789\uD06C\uD39C\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984162
    m_Localized: "\uBAA8\uC73C\uBA74 \uD50C\uB808\uC774\uC5B4 \uB808\uBCA8\uC774 \uC62C\uB77C\uC694.\n\uB808\uBCA8\uC774 \uC624\uB974\uBA74 \uC0C8 \uC2A4\uD0AC\uACFC \uC7A5\uBE44\uAC00 \uC5F4\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984163
    m_Localized: "3\uC131\uC73C\uB85C \uD074\uB9AC\uC5B4\uD574\uC11C \uCD94\uAC00\uB85C \uBC1B\uC740 \uACBD\uD5D8\uCE58\uC608\uC694.\n\uC9C0\uAE09 \uACBD\uD5D8\uCE58 \uD569\uACC4\uC5D0 \uC774\uBBF8 \uD3EC\uD568\uB418\uC5B4 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984164
    m_Localized: "\uBCF4\uC11D\uC774 \uB4E4\uC5B4 \uC788\uB294 \uC0C1\uC790\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984165
    m_Localized: "\uC2A4\uD0AC\uC744 \uAC15\uD654\uD560 \uB54C \uC4F0\uB294 \uB9C8\uBC95\uBD81\uC774\uC5D0\uC694.\n\uC2A4\uD0AC \uD654\uBA74\uC5D0\uC11C \uC0AC\uC6A9\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984166
    m_Localized: "\uC7A5\uBE44\uB97C \uAC15\uD654\uD560 \uB54C \uC4F0\uB294 \uC8FC\uBB38\uC11C\uC608\uC694.\n\uCE90\uB9AD\uD130 \uD654\uBA74\uC5D0\uC11C \uC0AC\uC6A9\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984167
    m_Localized: "\uBCF4\uAD00 \uC911\uC778 \uC544\uC774\uD15C\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
