  - m_Id: 37050177806341
    m_Localized: "\uB4F1\uC7A5 \uC694\uB9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806342
    m_Localized: "\uC784\uBB34 \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806343
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806344
    m_Localized: "\uBA54\uB274"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806345
    m_Localized: "\uC5B4\uB54C\uC694? \uC774 \uC815\uB3C4\uCBE4\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806346
    m_Localized: "\uC560\uD50C\uB85C \uB85C\uADF8\uC778\n"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806347
    m_Localized: "\uAD6C\uAE00\uB85C \uB85C\uADF8\uC778\n"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806348
    m_Localized: "\uAC8C\uC2A4\uD2B8\uB85C \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806349
    m_Localized: "\uB2E4\uC2DC \uC2DC\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806350
    m_Localized: "\uBD84\uC11D\uC740 \uB450 \uC120\uD0DD \uBAA8\uB450 \uB3D9\uC758\uD55C \uACBD\uC6B0\uC5D0\uB9CC \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uBBF8\uC120\uD0DD\uD574\uB3C4 \uD50C\uB808\uC774\uD560 \uC218 \uC788\uACE0, \uC120\uD0DD\uC740 \uC800\uC7A5\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806351
    m_Localized: "(\uC120\uD0DD) \uAC8C\uC784 \uC774\uC6A9 \uBD84\uC11D \uC218\uC9D1\xB7\uC774\uC6A9\uC5D0 \uB3D9\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806352
    m_Localized: "(\uC120\uD0DD) \uBD84\uC11D \uC815\uBCF4\uC758 \uAD6D\uC678 \uC774\uC804\uC5D0 \uB3D9\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806353
    m_Localized: "\uC0C1\uC138\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806354
    m_Localized: "\uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC740 \uCC98\uB9AC\uC0AC\uD56D \uC548\uB0B4\uC785\uB2C8\uB2E4.\n\uD14C\uC2A4\uD2B8 \uC9C4\uD589 \uC720\uC9C0\xB7\uC815\uC2DD \uC11C\uBE44\uC2A4 \uC774\uC804\uC740 \uBCF4\uC7A5\uB418\uC9C0 \uC54A\uC73C\uBA70,\n\uACC4\uC815 \uC0AD\uC81C \uD6C4 \uBCF5\uAD6C \uC720\uC608\uAE30\uAC04\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806355
    m_Localized: "\uC774\uC6A9\uC57D\uAD00 \uC804\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806356
    m_Localized: "\uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806357
    m_Localized: "\uB3D9\uC758\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806358
    m_Localized: "\uC774\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806359
    m_Localized: "\uB3D9\uC758 \uC548 \uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806360
    m_Localized: "\uCC98\uB9AC \uC218\uD0C1\uC790: GameAnalytics\n\uD56D\uBAA9: \uBD84\uC11D\uC6A9 \uC2DD\uBCC4\uC790, \uAE30\uAE30\xB7\uC571\xB7\uC138\uC158\xB7\uAD6D\uAC00 \uC815\uBCF4,\n\uC804\uD22C \uACB0\uACFC\xB7\uC6E8\uC774\uBE0C\xB7\uC2DC\uAC04\xB7\uCC98\uCE58\xB7\uC2A4\uD0AC \uD53C\uD574\uB7C9\xB7\uCE74\uB4DC \uC120\uD0DD\n\uBAA9\uC801: \uC774\uC6A9 \uD604\uD669\xB7\uBC38\uB7F0\uC2A4 \uAC1C\uC120\n\uBCF4\uAD00: \uC6D0\uC2DC\xB7\uC8FC\uC11D 1\uAC1C\uC6D4 / Player Warehouse 1\uB144 /\n\uC720\uC9C0\uC728 \uACC4\uC0B0\uC6A9 Player Lookup 18\uAC1C\uC6D4"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806361
    m_Localized: "\uBC1B\uB294 \uACF3: GameAnalytics ApS \uBC0F \uAD00\uACC4\uC0AC (\uBBF8\uAD6D)\n\uC5F0\uB77D\uCC98: privacy@gameanalytics.com\n\uC774\uC804: \uAC8C\uC784 \uC774\uC6A9 \uC911 SDK \uB124\uD2B8\uC6CC\uD06C \uC804\uC1A1\n\uD56D\uBAA9\xB7\uBAA9\uC801\xB7\uBCF4\uAD00: \uC704 \uBD84\uC11D \uD56D\uBAA9\uACFC \uB3D9\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806362
    m_Localized: "\uBD84\uC11D\uC740 \uB450 \uC120\uD0DD \uBAA8\uB450 \uB3D9\uC758\uD55C \uACBD\uC6B0\uC5D0\uB9CC \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uBBF8\uC120\uD0DD\uD574\uB3C4 \uD50C\uB808\uC774\uD560 \uC218 \uC788\uACE0, \uC120\uD0DD\uC740 \uC800\uC7A5\uB429\uB2C8\uB2E4.\n\uC124\uC815 \u2192 \uAC1C\uC778\uC815\uBCF4 \uC120\uD0DD\uC5D0\uC11C \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\nUnity \uC9C4\uB2E8\uC740 \uC774 \uC120\uD0DD\uACFC \uBCC4\uAC1C\uC785\uB2C8\uB2E4.\n\uC774\uBCA4\uD2B8 \uC911\uC9C0\uB294 SDK \uC804\uCCB4 \uD1B5\uC2E0 \uC885\uB8CC\uC640 \uB2E4\uB985\uB2C8\uB2E4.\n\uC644\uC804 \uC885\uB8CC\xB7\uC7AC\uC2E4\uD589 \uD6C4 \uC0C8 \uC120\uD0DD\uC744 \uC801\uC6A9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806363
    m_Localized: "\uB3D9\uC758\uD558\uC9C0 \uC54A\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806364
