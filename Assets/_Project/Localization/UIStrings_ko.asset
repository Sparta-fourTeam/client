  - m_Id: 39957484789837
    m_Localized: "\uC789\uD06C\uD39C {0}\uAC1C \uC18C\uBAA8\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789838
    m_Localized: "\uC694\uB9C8 {0}\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789839
    m_Localized: "\uD018\uC2A4\uD2B8 \uBCF4\uC0C1\uC744 \uBC1B\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789840
    m_Localized: "\uD018\uC2A4\uD2B8 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789841
    m_Localized: "{0} \uD018\uC2A4\uD2B8 \xB7 \uC774\uBBF8 \uC218\uB839\uD55C \uBCF4\uC0C1\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789842
    m_Localized: "{0} \uD018\uC2A4\uD2B8 \xB7 \uC810\uC218 {1}\uC810\uC744 \uBAA8\uC73C\uBA74 \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789843
    m_Localized: "\uBCF4\uBB3C\uC0C1\uC790 {0}\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789844
    m_Localized: "\uBCF4\uBB3C\uC0C1\uC790 \uBCF4\uC0C1\uC744 \uBC1B\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789845
    m_Localized: "\uBCF4\uBB3C\uC0C1\uC790 \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789846
    m_Localized: "\uBA54\uC77C \uC791\uC131 \uD654\uBA74\uC774 \uC5F4\uB824\uC694.\n\uC5F4\uB9AC\uC9C0 \uC54A\uC73C\uBA74 \uBB38\uC758 \uC591\uC2DD\uC774 \uBCF5\uC0AC\uB418\uC5B4 \uC788\uC73C\uB2C8\n{0}\uB85C \uBD99\uC5EC \uB123\uC5B4 \uBCF4\uB0B4 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789847
    m_Localized: "\uB85C\uADF8\uC544\uC6C3\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789848
    m_Localized: "\uAC8C\uC2A4\uD2B8\uB85C \uD50C\uB808\uC774 \uC911\uC774\uB77C\uBA74 \uBAA8\uB4E0 \uB370\uC774\uD130\uAC00 \uC0AD\uC81C\uB418\uBA70 \uBCF5\uAD6C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789849
    m_Localized: "\uACC4\uC815\uC744 \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789850
    m_Localized: "\uACC4\uC815\uACFC \uC9C4\uD589 \uB370\uC774\uD130\uAC00 \uC989\uC2DC \uC0AD\uC81C\uB418\uBA70 \uBCF5\uAD6C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uAC19\uC740 Google \uACC4\uC815\uC73C\uB85C \uB2E4\uC2DC \uAC00\uC785\uD574\uB3C4 \uCC98\uC74C\uBD80\uD130 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789851
    m_Localized: "\uBCF5\uAD6C \uC720\uC608 \uC5C6\uC774 \uBAA8\uB4E0 \uC9C4\uD589 \uB370\uC774\uD130\uAC00 \uC0AD\uC81C\uB429\uB2C8\uB2E4.\n\uC0AD\uC81C\uD558\uB824\uBA74 \uC544\uB798 \uB2C9\uB124\uC784\uC744 \uC785\uB825\uD574 \uC8FC\uC138\uC694.\n\n<noparse>{0}</noparse>"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789852
    m_Localized: "\uB2C9\uB124\uC784\uC744 \uC785\uB825\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789853
    m_Localized: "\uC0AD\uC81C \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789854
    m_Localized: "{0} \uC644\uB8CC\uB97C \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB85C\uADF8\uC778 \uC815\uBCF4\uB97C \uB2E4\uC2DC \uD655\uC778\uD55C \uB4A4 \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789855
    m_Localized: "{0} \uC644\uB8CC\uB97C \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC5F0\uACB0 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uACE0 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694. \uBB38\uC81C\uAC00 \uACC4\uC18D\uB418\uBA74 \uBB38\uC758\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789856
    m_Localized: "\uACC4\uC815 \uC791\uC5C5\uC744 \uC644\uB8CC\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC571\uC744 \uB2E4\uC2DC \uC2E4\uD589\uD55C \uB4A4 \uD655\uC778\uD574 \uC8FC\uC138\uC694. \uBB38\uC81C\uAC00 \uACC4\uC18D\uB418\uBA74 \uBB38\uC758\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789857
    m_Localized: "{0} \uD655\uC778 \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789858
    m_Localized: "\uB2E4\uC2DC \uB85C\uADF8\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789859
    m_Localized: "\uACC4\uC815\uC774 \uC5F0\uB3D9\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789860
    m_Localized: "\uC774\uBBF8 \uC5F0\uB3D9\uB41C \uACC4\uC815\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789861
    m_Localized: "\uC5F0\uB3D9\uD560 \uC218 \uC788\uB294 \uACC4\uC815\uC774 \uC544\uC9C1 \uC5C6\uC2B5\uB2C8\uB2E4. \uC900\uBE44 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789862
    m_Localized: "\uC774\uBBF8 \uC5F0\uB3D9\uB41C \uACC4\uC815\uC774\uAC70\uB098, \uB2E4\uB978 \uACC4\uC815\uC5D0 \uC5F0\uB3D9\uB41C \uAD6C\uAE00 \uACC4\uC815\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789863
    m_Localized: "\uACC4\uC815\uC744 \uC5F0\uB3D9\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC7A0\uC2DC \uD6C4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789864
    m_Localized: "\uACC4\uC815 \uC5F0\uB3D9\uC744 \uC644\uB8CC\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uAE30\uC874 \uACC4\uC815\uC73C\uB85C \uB2E4\uC2DC \uB85C\uADF8\uC778\uD55C \uB4A4 \uC5F0\uB3D9\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789865
    m_Localized: "\uC54C\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 39957484789866
    m_Localized: "\uC5D8\uB9AC\uD2B8 \uBCF4\uC0C1  {0} / {1}"
