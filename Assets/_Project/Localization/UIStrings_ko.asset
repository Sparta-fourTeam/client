      m_Items: []
  - m_Id: 39957488984098
    m_Localized: "\uB85C\uADF8\uC778\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.\n\uC7A0\uC2DC \uD6C4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984099
    m_Localized: "{0} (\uC900\uBE44 \uC911)"
    m_Metadata:
      m_Items: []
  - m_Id: 39957488984100
    m_Localized: "\uAC8C\uC2A4\uD2B8 \uACC4\uC815\uC740 \uC571\uC744 \uC0AD\uC81C\uD558\uAC70\uB098 \uAE30\uAE30\uB97C \uBC14\uAFB8\uBA74 \uB370\uC774\uD130\uAC00 \uC0AC\uB77C\uC9C8 \uC218 \uC788\uC5B4\uC694."
