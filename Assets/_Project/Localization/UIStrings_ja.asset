    m_Metadata:
      m_Items: []
  - m_Id: 37050177806350
    m_Localized: "\u5206\u6790\u306F\u4E21\u65B9\u306E\u9805\u76EE\u306B\u540C\u610F\u3057\u305F\u5834\u5408\u306E\u307F\u958B\u59CB\u3055\u308C\u307E\u3059\u3002\n\u9078\u629E\u3057\u306A\u304F\u3066\u3082\u30D7\u30EC\u30A4\u3067\u304D\u3001\u9078\u629E\u5185\u5BB9\u306F\u4FDD\u5B58\u3055\u308C\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806351
    m_Localized: "(\u4EFB\u610F) \u30B2\u30FC\u30E0\u5229\u7528\u5206\u6790\u306E\u53CE\u96C6\u30FB\u5229\u7528\u306B\u540C\u610F\u3057\u307E\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806352
    m_Localized: "(\u4EFB\u610F) \u5206\u6790\u60C5\u5831\u306E\u56FD\u5916\u79FB\u8EE2\u306B\u540C\u610F\u3057\u307E\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806353
    m_Localized: "\u8A73\u7D30\u3092\u898B\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806354
    m_Localized: "\u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u30DD\u30EA\u30B7\u30FC\u306F\u53D6\u308A\u6271\u3044\u4E8B\u9805\u306E\u3054\u6848\u5185\u3067\u3059\u3002\n\u30C6\u30B9\u30C8\u9032\u884C\u306E\u7DAD\u6301\u30FB\u6B63\u5F0F\u30B5\u30FC\u30D3\u30B9\u3078\u306E\u5F15\u304D\u7D99\u304E\u306F\u4FDD\u8A3C\u3055\u308C\u305A\u3001\n\u30A2\u30AB\u30A6\u30F3\u30C8\u524A\u9664\u5F8C\u306E\u5FA9\u65E7\u7336\u4E88\u671F\u9593\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806355
    m_Localized: "\u5229\u7528\u898F\u7D04\u5168\u6587"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806356
    m_Localized: "\u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u30DD\u30EA\u30B7\u30FC"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806357
    m_Localized: "\u540C\u610F\u3057\u307E\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806358
    m_Localized: "\u623B\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806359
    m_Localized: "\u540C\u610F\u3057\u306A\u3044"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806360
    m_Localized: "\u51E6\u7406\u53D7\u8A17\u8005: GameAnalytics\n\u9805\u76EE: \u5206\u6790\u7528\u8B58\u5225\u5B50\u3001\u7AEF\u672B\u30FB\u30A2\u30D7\u30EA\u30FB\u30BB\u30C3\u30B7\u30E7\u30F3\u30FB\u56FD\u60C5\u5831\u3001\n\u6226\u95D8\u7D50\u679C\u30FB\u30A6\u30A7\u30FC\u30D6\u30FB\u6642\u9593\u30FB\u6483\u7834\u6570\u30FB\u30B9\u30AD\u30EB\u30C0\u30E1\u30FC\u30B8\u91CF\u30FB\u30AB\u30FC\u30C9\u9078\u629E\n\u76EE\u7684: \u5229\u7528\u72B6\u6CC1\u30FB\u30D0\u30E9\u30F3\u30B9\u6539\u5584\n\u4FDD\u7BA1: \u751F\u30C7\u30FC\u30BF\u30FB\u6CE8\u91C8 1\u304B\u6708 / Player Warehouse 1\u5E74 /\n\u7D99\u7D9A\u7387\u8A08\u7B97\u7528 Player Lookup 18\u304B\u6708"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806361
    m_Localized: "\u63D0\u4F9B\u5148: GameAnalytics ApS \u304A\u3088\u3073\u95A2\u9023\u4F1A\u793E (\u7C73\u56FD)\n\u9023\u7D61\u5148: privacy@gameanalytics.com\n\u79FB\u8EE2: \u30B2\u30FC\u30E0\u5229\u7528\u4E2D\u306ESDK\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u9001\u4FE1\n\u9805\u76EE\u30FB\u76EE\u7684\u30FB\u4FDD\u7BA1: \u4E0A\u8A18\u306E\u5206\u6790\u9805\u76EE\u3068\u540C\u3058"
    m_Metadata:
      m_Items: []
  - m_Id: 37050177806362
    m_Localized: "\u5206\u6790\u306F\u4E21\u65B9\u306E\u9805\u76EE\u306B\u540C\u610F\u3057\u305F\u5834\u5408\u306E\u307F\u958B\u59CB\u3055\u308C\u307E\u3059\u3002\n\u9078\u629E\u3057\u306A\u304F\u3066\u3082\u30D7\u30EC\u30A4\u3067\u304D\u3001\u9078\u629E\u5185\u5BB9\u306F\u4FDD\u5B58\u3055\u308C\u307E\u3059\u3002\n\u8A2D\u5B9A \u2192 \u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u9078\u629E\u3067\u5909\u66F4\u3067\u304D\u307E\u3059\u3002\nUnity\u8A3A\u65AD\u306F\u3053\u306E\u9078\u629E\u3068\u306F\u5225\u3067\u3059\u3002\n\u30A4\u30D9\u30F3\u30C8\u505C\u6B62\u306FSDK\u5168\u4F53\u306E\u901A\u4FE1\u7D42\u4E86\u3068\u306F\u7570\u306A\u308A\u307E\u3059\u3002\n\u5B8C\u5168\u306B\u7D42\u4E86\u3057\u3066\u518D\u8D77\u52D5\u3059\u308B\u3068\u65B0\u3057\u3044\u9078\u629E\u304C\u9069\u7528\u3055\u308C\u307E\u3059\u3002"
