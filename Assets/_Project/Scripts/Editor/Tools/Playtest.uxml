<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="Tools.uss" />
  <ui:VisualElement class="tool-root">
    <ui:Label text="오류 재현 · 세이브 백업" class="heading" />
    <ui:Label name="runtimeStatus" class="runtime-status" />
    <ui:ScrollView class="playtest-scroll">
      <ui:VisualElement class="section">
        <ui:Label text="결과 제출 실패" class="section-title" />
        <ui:Label text="실패를 설정한 뒤 게임에서 포기하거나 전투를 끝내세요. 오류 화면에서 재시도할 수 있습니다." class="note" />
        <ui:VisualElement class="row playtest-actions">
          <ui:Button name="failButton" text="자동 재시도까지 실패시키기" />
          <ui:Button name="clearFaultButton" text="실패 설정 해제" />
        </ui:VisualElement>
        <ui:Label name="faultStatus" class="status" />
      </ui:VisualElement>
      <ui:VisualElement class="section">
        <ui:Label text="강제 패배" class="section-title" />
        <ui:Button name="breakWallButton" text="방벽 파괴 → 패배 재현" />
        <ui:Label name="wallStatus" class="status" />
      </ui:VisualElement>
      <ui:VisualElement class="section">
        <ui:Label text="프로필 치트 (재생 중 · Local)" class="section-title" />
        <ui:Button name="allResourcesButton" text="모든 재화 999로 설정" />
        <ui:Label text="세이브를 고친 뒤 즉시 프로필에 반영합니다. 레벨업 팝업은 로비 진입 시 비교하므로 전투 후 로비로 돌아올 때 확인하세요." class="note" />
        <ui:VisualElement class="row">
          <ui:IntegerField name="goldField" value="1000" class="grow" />
          <ui:Button name="addGoldButton" text="골드 지급" />
          <ui:Button name="fillEnergyButton" text="에너지 충전" />
        </ui:VisualElement>
        <ui:VisualElement class="row">
          <ui:IntegerField name="gemField" value="1000" class="grow" />
          <ui:Button name="addGemButton" text="잼 지급" />
          <ui:Button name="resetShopButton" text="일일상점 초기화" />
        </ui:VisualElement>
        <ui:VisualElement class="row">
          <ui:IntegerField name="levelField" value="2" class="grow" />
          <ui:Button name="setLevelButton" text="레벨 설정 (전부 해금)" />
          <ui:Button name="setLevelEdgeButton" text="레벨업 직전" />
        </ui:VisualElement>
        <ui:VisualElement class="row playtest-actions">
          <ui:Button name="completeTutorialsButton" text="튜토리얼 모두 완료" />
          <ui:Button name="resetTutorialsButton" text="튜토리얼 초기화" />
          <ui:Button name="unlockStagesButton" text="스테이지 모두 해금" />
          <ui:Button name="clearStagesButton" text="스테이지 모두 클리어 (기능 해금)" />
        </ui:VisualElement>
        <ui:Label name="cheatStatus" class="status" />
      </ui:VisualElement>
      <ui:VisualElement class="section">
        <ui:Label text="전투 치트" class="section-title" />
        <ui:VisualElement class="row playtest-actions">
          <ui:Button name="healWallButton" text="방벽 전체 회복" />
          <ui:Button name="speed1Button" text="1x" />
          <ui:Button name="speed4Button" text="4x" />
          <ui:Button name="speed8Button" text="8x" />
        </ui:VisualElement>
        <ui:Label text="치트 배속은 현재 전투에서 일시정지·보상 후에도 유지됩니다. 1x를 누르거나 전투를 나가면 해제됩니다." class="note" />
      </ui:VisualElement>
      <ui:VisualElement class="section">
        <ui:Label text="세이브 백업 · 삭제" class="section-title" />
        <ui:Label text="재생을 종료하면 현재 save.json을 같은 폴더에 백업하거나 지울 수 있습니다. 지우기 전에는 자동으로 백업하며, 다음 재생은 새 세이브로 시작합니다." class="note" />
        <ui:Label name="savePath" class="note" />
        <ui:VisualElement class="row playtest-actions">
          <ui:Button name="backupSaveButton" text="세이브 백업" />
          <ui:Button name="deleteSaveButton" text="세이브 삭제" />
        </ui:VisualElement>
        <ui:VisualElement class="row playtest-actions">
          <ui:Button name="restoreSaveButton" text="최근 백업으로 복원" />
        </ui:VisualElement>
        <ui:Label text="같은 초에 만든 구형 백업이 여러 개면 최신을 확정할 수 없어 자동 복원하지 않습니다." class="note" />
        <ui:Label name="saveStatus" class="status" />
      </ui:VisualElement>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
